# Application Port
PORT=3000

# Environment Mode
NODE_ENV=production

# Storage Driver: 'postgres' (default in docker) or 'memory' (for local unit test)
STORAGE_DRIVER=postgres

# PostgreSQL Connection Configuration (in docker-compose network, host is 'postgres')
DATABASE_URL=postgres://postgres:postgres_secure_pwd@postgres:5432/mekong_crm
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Security - JWT Secret Key (min 32 characters)
# Leave empty for Docker Compose to generate an ephemeral local-only secret.
JWT_SECRET=

# Business Working Hours Configuration for SLA Calculation
BUSINESS_TIMEZONE_OFFSET_MINUTES=420
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=17
BUSINESS_WORKING_DAYS=1,2,3,4,5,6
BUSINESS_HOLIDAYS=
