        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nhide circle\nskinparam linetype ortho\n\nnote \&quot;Sơ đồ ERD Luồng L2 - Track SE\\nĐã chuẩn hóa 3NF và bổ sung Index theo NFR\&quot; as N1\n\nentity \&quot;customer\&quot; {\n  * customer_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * phone : VARCHAR(20) &lt;&lt;UNIQUE&gt;&gt;\n  * full_name : VARCHAR(120)\n  created_at : TIMESTAMPTZ\n}\n\nentity \&quot;device\&quot; {\n  * device_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * customer_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * serial_no : VARCHAR(50) &lt;&lt;UNIQUE&gt;&gt;\n  * warranty_months : SMALLINT\n}\n\nentity \&quot;technician\&quot; {\n  * technician_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * level : VARCHAR(10)\n  * is_active : BOOLEAN\n}\n\nentity \&quot;ticket\&quot; {\n  * ticket_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * ticket_code : VARCHAR(20) &lt;&lt;UNIQUE&gt;&gt;\n  * customer_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * device_id : BIGINT &lt;&lt;FK&gt;&gt;\n  technician_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  * issue_desc : TEXT\n  * priority : VARCHAR(10)\n  * status : VARCHAR(20)\n  * due_date : TIMESTAMPTZ\n  --\n  &lt;&lt;INDEX&gt;&gt; (status, due_date)\n}\n\nentity \&quot;ticket_status_log\&quot; {\n  * log_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * ticket_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * to_status : VARCHAR(20)\n  * changed_at : TIMESTAMPTZ\n}\n\n&#39; Định nghĩa các mối quan hệ (1-Nhiều)\ncustomer ||--o{ device : \&quot;Sở hữu\&quot;\ncustomer ||--o{ ticket : \&quot;Tạo\&quot;\ndevice ||--o{ ticket : \&quot;Bảo hành\&quot;\ntechnician |o--o{ ticket : \&quot;Được gán\&quot;\nticket ||--o{ ticket_status_log : \&quot;Lưu lịch sử\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Qqr6oIlVZD2EOh3Lcnsy-21">
