  <diagram name="Trang-1" id="x5aTvWumF0uJH894zTFs">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam componentStyle rectangle\nskinparam handwritten false\n\nnote \&quot;CHÚ THÍCH SƠ ĐỒ:\\n- Mũi tên nét liền: Phụ thuộc một chiều / Lời gọi hàm (từ trên xuống).\\n- Khối chữ nhật: Tên lớp và trách nhiệm tương ứng.\\n- NGOÀI PHẠM VI: Chức năng gửi SMS/Email thông báo cho khách hàng (Mức WON&#39;T).\&quot; as N1\n\npackage \&quot;Kiến trúc Phân lớp (Layered Architecture) - Luồng L2 (Tiếp nhận &amp; Phân loại)\&quot; {\n    \n    component \&quot;1. LỚP TRÌNH BÀY (Presentation Layer)\\n\\n[Trang tiếp nhận]   [Danh sách phiếu]   [Trang phân công]\\n\\nTrách nhiệm: Nhận đầu vào của người dùng, hiển thị kết quả.\\nKHÔNG chứa quy tắc nghiệp vụ, KHÔNG truy vấn dữ liệu trực tiếp.\&quot; as UI\n    \n    component \&quot;2. LỚP NGHIỆP VỤ (Business / Service Layer)\\n\\n- TicketService: Tạo phiếu, kiểm tra quy tắc bắt buộc\\n- ClassifyService: Đề xuất nhóm sự cố và mức ưu tiên\\n- AssignService: Gán kỹ thuật viên theo tay nghề\\n\\nTrách nhiệm: Chứa TOÀN BỘ quy trình và quy tắc nghiệp vụ.\\nKHÔNG biết dữ liệu được lưu bằng công nghệ gì.\&quot; as BLL\n\n    component \&quot;3. LỚP TRUY CẬP DỮ LIỆU (Repository / DAO)\\n\\n- TicketRepository\\n- CustomerRepository\\n- TechnicianRepository\\n\\nTrách nhiệm: Đọc và ghi dữ liệu, che giấu chi tiết công nghệ lưu trữ.\\nKHÔNG chứa quy tắc nghiệp vụ.\&quot; as DAL\n\n    component \&quot;4. LỚP LƯU TRỮ (Data Store)\\n\\nCơ sở dữ liệu (PostgreSQL)\\n\\nTrách nhiệm: Lưu giữ dữ liệu và bảo đảm toàn vẹn ở mức lược đồ\\n(Các bảng: ticket, customer, technician...)\&quot; as DB\n\n    &#39; Mối quan hệ trao đổi\n    UI --&gt; BLL : Giao tiếp qua HTTP + JSON\\n(Hợp đồng API ở docs/api.md)\n    BLL --&gt; DAL : Gọi qua giao diện (Interface) Repository\n    DAL --&gt; DB : Truy vấn SQL\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nPTC2no94vJM44x9iDPa-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
